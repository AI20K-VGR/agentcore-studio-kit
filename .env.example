# AgentCore Studio — environment variables. Copy to `.env` and fill in real values (never commit
# `.env` itself — see .gitignore). P1 stub set; extended per phase as wiring lands.

# --- Postgres (Decision #2 Postgres-everything, Decision #3 RLS fence) ---
# 2 role/DSN split, NOT 1: studio_owner (DDL + admin, bypasses RLS as table owner via
# get_admin_pool) vs studio_app (runtime DML only, RLS enforced via get_pool). Never point the
# app's runtime connection at studio_owner — that would silently disable the fence.
STUDIO_DATABASE_URL=postgresql://studio_app:changeme@localhost:5432/studio
STUDIO_DATABASE_URL_ADMIN=postgresql://studio_owner:changeme@localhost:5432/studio

# --- Gemini LLM provider (Decision #9 — shared infra, LLM-only; embedding stays AIE-1's seam) ---
STUDIO_GEMINI_API_KEY=changeme

# --- LLM provider discriminator (app#19 — OpenAI o4-mini chính, Gemini rollback) ---
# StrEnum đóng ("openai" | "gemini") — REQUIRED, không default: giá trị thiếu/lạ raise
# ValidationError lúc boot, đúng nguyên tắc "giá trị lạ/thiếu phải ồn" (giống STUDIO_JWT_SECRET).
STUDIO_LLM_PROVIDER=gemini
STUDIO_OPENAI_API_KEY=changeme

# --- Feature flags ---
STUDIO_ENABLE_TRACING=false
STUDIO_USE_FAKE_PROVIDERS=true

# --- JWT (Kế hoạch 2/3, A1/A2 — ký/verify identity {tenant_id, user, roles}) ---
# Đây là khoá KÝ THẬT — không có identity provider (mật khẩu/OAuth) đứng sau /api/auth/demo-login,
# nhưng chữ ký JWT là thật: không có khoá này, không ai tự chế được token hợp lệ. Sinh 1 khoá dài,
# ngẫu nhiên cho môi trường thật, KHÔNG commit giá trị thật vào .env.
# `Settings.jwt_secret` ép `min_length=32` (kit#129 §3.3 mục #3, VinSOC pentest — trước bản vá,
# app chạy bình thường với "changeme", cho phép forge JWT). Placeholder dưới đây CHỈ để chạy
# dev-stack cục bộ (đủ dài để qua validation) — sinh khoá thật cho môi trường thật bằng:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
STUDIO_JWT_SECRET=local-dev-placeholder-not-for-production-use
STUDIO_JWT_EXPIRE_MINUTES=480

# --- Langfuse (optional obs backend, `pip install .[obs]`) ---
STUDIO_LANGFUSE_PUBLIC_KEY=
STUDIO_LANGFUSE_SECRET_KEY=
STUDIO_LANGFUSE_HOST=
