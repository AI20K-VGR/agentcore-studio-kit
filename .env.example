# AgentCore Studio — environment variables. Copy to `.env` and fill in real values (never commit
# `.env` itself — see .gitignore). P1 stub set; extended per phase as wiring lands.

# --- Postgres (Decision #2 Postgres-everything, Decision #3 RLS fence) ---
# 3 role/DSN split, NOT 1: studio_owner (DDL + admin, bypasses RLS as table owner via
# get_admin_pool) vs studio_app (runtime DML only, RLS enforced via get_pool). Never point the
# app's runtime connection at studio_owner — that would silently disable the fence.
STUDIO_DATABASE_URL=postgresql://studio_app:changeme@localhost:5432/studio
STUDIO_DATABASE_URL_ADMIN=postgresql://studio_owner:changeme@localhost:5432/studio
# studio_scorer (evalhub#37) — BYPASSRLS, SELECT on obs.trace_events ONLY. Used by evalhub's
# cross-tenant scoring CLI (`python -m studio_evalhub.run_report`), whose two readers deliberately
# do not set `app.tenant_id` because they must see every tenant's events to detect a run that
# mixes tenants. After app#40 turned on FORCE RLS for obs.trace_events, those readers match 0 rows
# under any other role. NOT for the app runtime — the app must keep using STUDIO_DATABASE_URL.
STUDIO_DATABASE_URL_SCORER=postgresql://studio_scorer:changeme@localhost:5432/studio

# --- Gemini LLM provider (Decision #9 — shared infra, LLM-only; embedding stays AIE-1's seam) ---
STUDIO_GEMINI_API_KEY=changeme

# --- LLM provider discriminator (app#19 — OpenAI o4-mini chính, Gemini rollback) ---
# StrEnum đóng ("openai" | "gemini") — REQUIRED, không default: giá trị thiếu/lạ raise
# ValidationError lúc boot, đúng nguyên tắc "giá trị lạ/thiếu phải ồn" (giống STUDIO_JWT_SECRET).
# ⚠️ ĐỔI SANG `openai` khi demo bằng provider THẬT (README bước 3b). Giá trị `gemini` dưới đây là
# đường ROLLBACK. Set `STUDIO_USE_FAKE_PROVIDERS=false` mà quên dòng này thì `build_llm()` vẫn rẽ
# `case LlmProvider.GEMINI`, và vì `STUDIO_GEMINI_API_KEY=changeme` ở trên là truthy nên KHÔNG có
# 500 "thiếu key" để báo động — hỏng tận lúc gọi API. `LLMJudge` cũng dựng từ `build_llm()`
# (`routes/publish.py:204`), nên mọi số đo `gpt-4o-mini` dưới đây chỉ đúng khi biến này là `openai`.
STUDIO_LLM_PROVIDER=gemini
STUDIO_OPENAI_API_KEY=changeme

# Model cho `build_llm()` (đường OpenAI). BỎ TRỐNG = `gpt-4o-mini` — mặc định đó là kết quả đo,
# không phải sở thích: cùng golden 2.0 + embedding thật + cùng judge, 3 lượt mỗi model
# (`evalhub#31`), `gpt-4o-mini` cho success 0.9889 · citation 1.0000 → PASS 3/3, còn `o4-mini`
# cho 0.7556 · 0.6818–0.8636 → FAIL 3/3 (nó bỏ marker `[chunk_id]` dù chunk đúng đã ở trong ngữ
# cảnh). Chỉ set biến này khi CỐ Ý đo model khác.
STUDIO_OPENAI_MODEL=

# Base URL OpenAI-compatible. ĐỂ NGUYÊN COMMENT nếu dùng api.openai.com — KHÔNG khai dòng này
# với value rỗng: pydantic-settings đọc value rỗng trong `.env` thành `""` chứ KHÔNG phải `None`
# (đo), và `factory.py` truyền THẲNG `base_url=settings.openai_base_url` vào `AsyncOpenAI` ⇒
# `AsyncOpenAI(base_url='')` làm MỌI call LLM chết `APIConnectionError: Connection error.`, một
# thông điệp không nói được gì. (`STUDIO_OPENAI_MODEL` ở trên không dính bẫy này vì factory có
# `or "gpt-4o-mini"`.) Trỏ sang gateway khác thì bỏ comment và set cả `STUDIO_OPENAI_MODEL` cho
# khớp tên model của gateway đó, vd `https://openrouter.ai/api/v1` + `openai/gpt-4o-mini`.
# STUDIO_OPENAI_BASE_URL=

# `GatewayEmbedding` (app#30) — `google/gemini-embedding-001` @2048 qua OpenRouter. BẮT BUỘC khi
# `STUDIO_USE_FAKE_PROVIDERS=false`: thiếu nó thì `build_embedding()` trả 503 ngay ở nút "Chấm
# điểm"/`/evaluate`. Đây là biến RIÊNG của seam embedding, KHÔNG dùng chung với
# `STUDIO_OPENAI_API_KEY` (hai provider, hai hoá đơn, hai vòng đời khoá).
STUDIO_OPENROUTER_API_KEY=changeme

# --- Feature flags ---
STUDIO_ENABLE_TRACING=false
STUDIO_USE_FAKE_PROVIDERS=true

# `LLMJudge` cap/cache state (`apps/studio#20`). Default trong code là TUYỆT ĐỐI `/app/state/...`
# — đúng cho image (`/app` là `WORKDIR`, và compose mount `studio_judge_state:/app/state` để
# `cap` sống qua redeploy). KHÔNG dùng đường tương đối: nó giải theo CWD, nên chạy từ hai thư mục
# khác nhau trên cùng một máy cho HAI file cap ⇒ cap ≤100/ngày thành ≤200 mà không dòng code nào sai.
#
# CHẠY NGOÀI CONTAINER thì PHẢI override hai biến này. Không override ⇒ lần gọi judge đầu ném
# `PermissionError` (không ghi được `/app/state`) từ `_ghi_counter`, hàm đó nằm NGOÀI `try` trong
# `LLMJudge.judge()` nên nó thành 500 chưa bắt. Ồn ào, không im lặng — nhưng đừng mất buổi chiều vì nó.
# `state/` đã có trong `.gitignore` (cả gốc kit lẫn `apps/studio`).
#
# Hai dòng dưới CỐ Ý để comment và CỐ Ý không có giá trị sẵn: không có đường tuyệt đối nào đúng
# cho mọi máy, và giá trị tương đối ship sẵn thì chính là cái bẫy đoạn trên vừa cấm. Chạy ngoài
# container: bỏ comment và điền đường TUYỆT ĐỐI trên máy bạn (pydantic KHÔNG giãn `$PWD`/`~`).
#
# ⚠️ BẮT BUỘC kể cả khi `STUDIO_USE_FAKE_PROVIDERS=true` — hai biến này KHÔNG thuộc nhóm
# "provider thật". `routes/publish.py:204` dựng `LLMJudge` VÔ ĐIỀU KIỆN (judge nhận
# `ExtractiveFakeLLM` trên đường stub), và một case trượt exact-match là đủ để `_ghi_counter`
# chạm đĩa TRƯỚC khi parse phản hồi ⇒ bỏ trống hai dòng này thì nút "Chấm điểm" 500 ngay trên
# đường demo mặc định, không cần một key nào. README bước 1 nhắc lại đúng chỗ này.
# STUDIO_JUDGE_CACHE_PATH=/duong/tuyet/doi/toi/agentcore-studio-kit/state/judge-cache.json
# STUDIO_JUDGE_CAP_PATH=/duong/tuyet/doi/toi/agentcore-studio-kit/state/judge-cap.json

# --- JWT (Kế hoạch 2/3, A1/A2 — ký/verify identity {tenant_id, user, roles}) ---
# Đây là khoá KÝ THẬT — không có identity provider (mật khẩu/OAuth) đứng sau /api/auth/demo-login,
# nhưng chữ ký JWT là thật: không có khoá này, không ai tự chế được token hợp lệ. Sinh 1 khoá dài,
# ngẫu nhiên cho môi trường thật, KHÔNG commit giá trị thật vào .env.
# `Settings.jwt_secret` ép `min_length=32` (kit#129 §3.3 mục #3, VinSOC pentest — trước bản vá,
# app chạy bình thường với "changeme", cho phép forge JWT). Placeholder dưới đây CHỈ để chạy
# dev-stack cục bộ (đủ dài để qua validation) — sinh khoá thật cho môi trường thật bằng:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
STUDIO_JWT_SECRET=local-dev-placeholder-not-for-production-use
STUDIO_JWT_EXPIRE_MINUTES=480

# --- Superadmin credentials ---
STUDIO_DATABASE_URL_ADMIN=postgresql://studio_owner:changeme@localhost:5432/studio
STUDIO_DATABASE_URL=postgresql://studio_app:changeme@localhost:5432/studio
STUDIO_SUPERADMIN_EMAIL=superadmin@agentcore.internal
STUDIO_SUPERADMIN_PASSWORD=mat_khau_cua_ban

# --- Langfuse (optional obs backend, `pip install .[obs]`) ---
STUDIO_LANGFUSE_PUBLIC_KEY=
STUDIO_LANGFUSE_SECRET_KEY=
STUDIO_LANGFUSE_HOST=
